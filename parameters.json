{
  "min_change": 0.001,
  "window_sizes": [30, 60, 90],
  "overlap": 50,
  "top_patterns": 50,

  "pattern_detection": {
    "retracement_target": 0.5,
    "retracement_tolerance": 0.003,
    "completion_extension": 0.236,
    "failure_level": 0.88,
    "use_only_absolute_extremes": false,
    "use_progressive_search": false,
    "detect_correction_patterns": true,
    "search_beyond_window_for_failure": true,

    "validation_rules": {
      "min_points_separation": 2,
      "lookback_window": 3
    },

    "scoring_weights": {
      "initial_move": 2.0,
      "retracement_quality": 1.5,
      "absolute_extreme_bonus": 1.0,
      "accurate_failure_bonus": 0.5
    },

    "pattern_priority": {
      "completed": 3,
      "failed": 2,
      "pending": 1
    }
  },

  "data_processing": {
    "handle_gaps": true,
    "interpolate_missing": false,
    "outlier_removal": false,
    "outlier_threshold": 3.0,
    "min_data_points": 50
  },

  "output_settings": {
    "show_plots": true,
    "save_results": false,
    "verbose_logging": true
  },

  "advanced_options": {
    "enable_debugging": true,
    "pattern_validation": true,
    "deduplication_tolerance": 200
  }
}