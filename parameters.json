{
  "min_change": 0.001,
  "overlap": 0,
  "top_patterns": 50,
  "time_window": 120,

  "pattern_detection": {
    "retracement_target": 0.5,
    "retracement_tolerance": 0.001,
    "completion_extension": 0.236,
    "failure_level": 0.88,
    "min_move_multiplier": 1.0,

"use_only_absolute_extremes": true,
    "trailing_B_after_A": true,
    "allow_multiple_patterns": true,

    "significant_patterns_only": ["completed", "failed"],

    "pattern_priority": {
      "completed": 5,
      "failed": 3,
      "in_progress": 0
    },

    "scoring_weights": {
      "initial_move": 1.0,
      "retracement_quality": 2.0,
      "absolute_extreme_bonus": 3.0,
      "global_extreme_bonus": 2.0,
      "overlap_bonus": 1.5,
      "accurate_failure_bonus": 1.0
    },

    "validation_rules": {
      "min_points_separation": 5,
      "max_retracement_deviation": 0.02,
      "require_definitive_status": true,
      "validate_D_position": true
    }
  },

  "advanced_options": {
    "adaptive_lookback": false,
    "atr_period": 14,
    "volume_confirmation": false,
    "trend_alignment": true,
    "multi_timeframe_confirmation": false,
    "use_comprehensive_detection": false
  },

  "output_settings": {
    "save_plots": true,
    "plot_dpi": 300,
    "show_fibonacci_levels": true,
    "show_all_patterns": false,
    "highlight_failed_patterns": true,
    "highlight_global_extremes": true,
    "include_pattern_statistics": true,
    "mark_accurate_failure_points": true
  },

  "data_processing": {
    "handle_gaps": true,
    "interpolate_missing": false,
    "outlier_removal": false,
    "outlier_threshold": 3.0,
    "min_data_points": 50
  },

  "display_options": {
    "show_A_as_global": true,
    "show_B_as_global": true,
    "use_special_markers": true,
    "label_key_points": true,
    "color_scheme": "status_based"
  }
}
